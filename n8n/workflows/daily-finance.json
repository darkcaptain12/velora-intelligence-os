{
  "name": "VELORA — Daily Finance (00:30)",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "cronExpression", "expression": "30 0 * * *" }] }
      },
      "id": "cron-daily",
      "name": "Her gün 00:30",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://web:3000/api/webhooks/n8n",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "Authorization", "value": "=Bearer {{$env.N8N_WEBHOOK_SECRET}}" }] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"event\":\"daily.finance\",\"queue\":\"financeSnapshot\"}",
        "options": {}
      },
      "id": "finance",
      "name": "Finans Anlık Görüntü",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 300]
    }
  ],
  "connections": {
    "Her gün 00:30": { "main": [[{ "node": "Finans Anlık Görüntü", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
