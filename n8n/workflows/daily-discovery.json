{
  "name": "VELORA — Daily Discovery (02:00)",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "cronExpression", "expression": "0 2 * * *" }] }
      },
      "id": "cron-daily-discovery",
      "name": "Her gün 02:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=http://web:3000/api/webhooks/n8n",
        "sendHeaders": true,
        "headerParameters": { "parameters": [{ "name": "Authorization", "value": "=Bearer {{$env.N8N_WEBHOOK_SECRET}}" }] },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"event\":\"daily.discovery\",\"queue\":\"productDiscovery\"}",
        "options": {}
      },
      "id": "discovery",
      "name": "Ürün Keşfi",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 300]
    }
  ],
  "connections": {
    "Her gün 02:00": { "main": [[{ "node": "Ürün Keşfi", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
